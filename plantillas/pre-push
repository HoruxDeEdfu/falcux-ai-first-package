#!/bin/sh
# El punto de control de la metodología AI-First, antes de publicar.
#
# Lo escribe `ai-first init`. Corre el detector de entropía documental sobre el
# rango que se va a empujar y **sin `--estricto`**: sólo un P0 interrumpe; un P1
# o un P2 se imprimen y el push sigue. Un hook que bloquea por todo se
# desinstala, y con él se van los cinco checks.
#
# Se salta con `git push --no-verify`. No se combate: el detector informa, la
# disciplina es del equipo.

# git entrega por entrada estándar una línea por referencia empujada:
#   <ref local> <sha local> <ref remota> <sha remoto>
# El sha remoto es la base del rango. Viene en ceros cuando la rama todavía no
# existe en el remoto: entonces no hay rango que comparar y se corre contra el
# árbol de trabajo, que es lo que hay.
base=""
while read -r _local_ref _local_sha _remote_ref remote_sha; do
  [ -z "$remote_sha" ] && continue
  case "$remote_sha" in
    *[!0]*) base="$remote_sha" ; break ;;
  esac
done

# Un push lanzado desde un cliente gráfico, un IDE o un servicio del sistema no
# hereda el PATH del shell: nvm, Homebrew y fnm se cargan en el perfil, que sólo
# lee una terminal interactiva. Sin esto, el hook muere con «node: command not
# found» y frena el push —que es justo lo que no debe hacer—.
if ! command -v node >/dev/null 2>&1; then
  export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
  if [ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]; then
    . "${NVM_DIR:-$HOME/.nvm}/nvm.sh" >/dev/null 2>&1
  fi
fi

# Ninguna de las formas de invocar el detector funciona sin node, así que se
# comprueba una sola vez y acá. No encontrarlo **nunca** frena un push.
if ! command -v node >/dev/null 2>&1; then
  echo "ai-first: no encuentro node, así que el punto de control no corrió."
  echo "          Si empujas desde un cliente gráfico, arráncalo desde una"
  echo "          terminal o deja node en /usr/local/bin."
  exit 0
fi

# El comando, sin exigir instalación global y sin bajar nada: el del proyecto
# primero, el del PATH después, y `npx --no-install` sólo si ya está en la caché.
if [ -x "node_modules/.bin/ai-first" ]; then
  ai_first="node_modules/.bin/ai-first"
elif command -v ai-first >/dev/null 2>&1; then
  ai_first="ai-first"
elif command -v npx >/dev/null 2>&1 && npx --no-install @falcux/ai-first --version >/dev/null 2>&1; then
  ai_first="npx --no-install @falcux/ai-first"
else
  # No encontrarse a sí mismo no es motivo para frenar un push.
  echo "ai-first: no está instalado, así que el punto de control no corrió."
  echo "          Instálalo con «pnpm add -D @falcux/ai-first» o quita este hook."
  exit 0
fi

if [ -n "$base" ]; then
  $ai_first audit --base "$base"
else
  $ai_first audit
fi
